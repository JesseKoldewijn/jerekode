    { "match": "^cat(\\s|$)", "mode": "prefix" },
    { "match": "^grep(\\s|$)", "mode": "prefix" },
    { "match": "^rg(\\s|$)", "mode": "prefix" },
    { "match": "^diff(\\s|$)", "mode": "prefix" },
