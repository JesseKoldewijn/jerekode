# Maintainer: Jesse Koldewijn
pkgname=jerekode
pkgver=0.0.0
pkgrel=1
pkgdesc="Rust port of OpenCode — OpenCode-compatible AI coding agent runtime"
arch=('x86_64')
url="https://github.com/JesseKoldewijn/jerekode"
license=('MIT')
depends=()
makedepends=()
source=()
options=('!strip')

package() {
  install -Dm755 "${startdir}/jerekode" "${pkgdir}/usr/bin/jerekode"
  install -Dm644 "${startdir}/README.txt" "${pkgdir}/usr/share/doc/${pkgname}/README.txt"
  install -Dm644 "${startdir}/SIDECAR.txt" "${pkgdir}/usr/share/doc/${pkgname}/SIDECAR.txt"
}
